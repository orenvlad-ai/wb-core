  "absence_rule": "sqlite_master/schema_version before and after all reads; existing empty tables are authorizer-observed and revisioned; newly created fallback table changes schema_version",
  "native_identity_checks": {
    "reader": "operator_ff_overhead._completion_source on caller writer connection before and after each DML; NativeProgressFence compares exact request-scoped mutable images and permits only explicit S1–S5 deltas",
    "tables": [
      "sheet_vitrina_v1_ff_pool_overhead_confirmations",
      "sheet_vitrina_v1_ff_pool_overhead_cancellations",
      "sheet_vitrina_v1_ff_pool_overhead_replacements",
      "sheet_vitrina_v1_ff_pool_document_requests",
      "sheet_vitrina_v1_ff_pool_documents",
      "sheet_vitrina_v1_ff_pool_document_lines",
      "sheet_vitrina_v1_ff_pool_document_expense_lines",
      "sheet_vitrina_v1_ff_pool_document_relations",
      "sheet_vitrina_v1_ff_pool_movement_lines",
      "sheet_vitrina_v1_warehouse_business_operations",
      "sheet_vitrina_v1_warehouse_targeted_recalc_queue",
      "sheet_vitrina_v1_recovery_operations",
      "sheet_vitrina_v1_ff_workflow_events",
      "sheet_vitrina_v1_recovery_transitions"
    ],
    "scope": "exact request/document/operation/queue identities and source digests; retained after_digest; complete replay event must match native after image; exact immutable recovery checkpoint/full scope; exact S1 proof and queue Finance marker; no native state regression"
  },
  "book": {
    "tables": [
      "accounting_current",
      "accounting_revisions",
      "accounting_blobs"
    ],
    "read": "one same-live readonly observer; detached book/current revision and every blob content hash verified; same observer data_version fenced before/after proof and while SQLite writer reservation excludes direct SQL",
    "writers": [
      "fbs_accounting_runtime._save_book",
      "fbs_accounting_historical_revision_writer",
      "direct SQL: excluded by writable attachment BEGIN IMMEDIATE"
    ],
    "schema_change": false
  },
  "authority": {
    "files": [
      "storage_generation_manifest.json",
      ".business-data-schedule-profile.json",
      "schedule transition authority records"
    ],
    "writers": [
      "storage_registry.atomic_write_manifest: exclusive generation_pin",
      "business_data_schedule_transition.apply/rollback: exclusive generation_pin",
      "finance_storage_migration: prepare/recopy replace inactive candidate; activation uses atomic_write_manifest"
    ],
    "file_replacement_guard": "manifest generation pin plus physical dev/inode and schema_version; SQLite backup-to-existing-file increments destination schema_version",
    "sqlite_metadata": {
      "tables": [
        "finance_operational_schema_meta",
        "finance_raw_schema_meta"
      ],
      "read_contract": "verify_registry_rows inside DependencyProof.observe after capture; exact schema_revision/logical_store/generation_id/generation_epoch/source_fingerprint match manifest; observed revision vector protects every later commit"
    }
  },
  "commits": [
    {
      "state": "S1",
      "owner": "operator_ff_overhead.prepare_guard",
      "writes": [
        "exact queue economics/finance fields",
        "same acceptance native_completion receipt"
      ]
    },
    {
      "state": "S2",
      "owner": "ff_pool_documents._finalize_posted",
      "writes": [
        "same request posted→replay",
        "same request replay running event"
      ]
    },
    {
      "state": "S3",
      "owner": "WarehouseRecoveryRegistry._transition",
      "writes": [
        "same recovery operation lifecycle CAS and after_digest",
        "one retained transition"
      ],
      "guard": "inside own BEGIN IMMEDIATE before DML and before commit"
    },
    {
      "state": "S4",
      "owner": "ff_pool_documents._finalize_posted",
      "writes": [
        "same request replay→complete",
        "matching complete replay event"
      ]
    },
    {
      "state": "S5",
      "owner": "operator_ff_overhead._update",
      "writes": [
        "same acceptance completed and native recovery receipt"
      ]
    }
  ],
  "lock_order": [
    "warehouse job ownership",
    "shared generation pin",
    "ff pool posting flock",
    "warehouse functional writer flock",
    "accounting writer flock",
    "single main connection BEGIN IMMEDIATE with rw raw/book attachments"
  ],
  "mutation_policy": "No posting call. No baseline reset. Proof dependency counters do not include mutable native lifecycle fields; those are validated by exact source/digest/event readback in every writer transaction. All proof scans run before first writer reservation. NativeProgressFence binds queue/status/proof and receipt bytes through all commits. Pending cohorts raise typed failure; cumulative completed effects remain durable."
