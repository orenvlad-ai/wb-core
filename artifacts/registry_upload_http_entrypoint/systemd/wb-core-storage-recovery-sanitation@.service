[Unit]
Description=WB Core exact detached storage sanitation job %i
After=local-fs.target
RequiresMountsFor=/opt/wb-core-runtime/state /opt/wb-core-runtime/backups
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/wb-core-runtime/app
ExecStart=/usr/bin/python3 apps/storage_recovery_sanitation_job.py --runtime-dir /opt/wb-core-runtime/state --root-backups /opt/wb-core-runtime/backups --deployed-sha-file /opt/wb-core-runtime/app/.wb-core-runtime-sha worker --job-id %i
TimeoutStartSec=2h
Restart=on-failure
RestartSec=5s
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/wb-core-runtime/state /opt/wb-core-runtime/backups
