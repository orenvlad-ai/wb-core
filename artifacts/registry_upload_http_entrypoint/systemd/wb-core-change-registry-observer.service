[Unit]
Description=WB Core read-only Prices and Ads Change Registry observer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/wb-core-runtime/app
Environment=CHANGE_REGISTRY_OBSERVER_ENABLED=true
Environment=CHANGE_REGISTRY_ACCOUNT_SCOPE=seller-portal-primary
ExecStart=/usr/bin/python3 apps/change_registry_observer.py --runtime-dir /opt/wb-core-runtime/state --env-file /opt/wb-ai/.env scan --trigger scheduled --requested-by systemd
TimeoutStartSec=30m
User=root
Group=root
