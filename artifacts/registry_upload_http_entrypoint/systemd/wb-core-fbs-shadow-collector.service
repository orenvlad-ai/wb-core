[Unit]
Description=WB Core dedicated official FBS read-only shadow collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/wb-core-runtime/app
ExecStart=/usr/bin/python3 apps/wb_fbs_shadow.py --runtime-dir /opt/wb-core-runtime/state --env-file /opt/wb-ai/.env poll
TimeoutStartSec=4m
User=root
Group=root
