[Unit]
Description=WB Core Sheet Vitrina Auto Refresh Tick
After=network.target wb-core-registry-http.service
Wants=network.target wb-core-registry-http.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wb-core-runtime/app
ExecStart=/usr/bin/python3 apps/sheet_vitrina_v1_auto_refresh_tick.py --env-file /opt/wb-ai/.env
TimeoutStartSec=1800
