[Unit]
Description=WB Core SPP Tester Daily Schedule Due Tick
After=network.target wb-core-registry-http.service
Wants=network.target wb-core-registry-http.service

[Service]
Type=oneshot
TimeoutStartSec=3h
WorkingDirectory=/opt/wb-core-runtime/app
Environment=PYTHONUNBUFFERED=1
Environment=REGISTRY_UPLOAD_RUNTIME_DIR=/opt/wb-core-runtime/state
EnvironmentFile=/opt/wb-ai/.env
ExecStart=/usr/bin/python3 /opt/wb-core-runtime/app/apps/wb_spp_tester_schedule_tick.py --runtime-dir /opt/wb-core-runtime/state
