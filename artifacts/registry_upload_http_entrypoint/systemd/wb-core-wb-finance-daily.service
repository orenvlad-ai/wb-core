[Unit]
Description=WB Core official daily Wildberries Finance synchronization tick
After=network.target wb-core-registry-http.service
Wants=network.target wb-core-registry-http.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wb-core-runtime/app
ExecStart=/usr/bin/python3 apps/wb_finance_daily.py tick --env-file /opt/wb-ai/.env --runtime-dir /opt/wb-core-runtime/state --max-days 2
TimeoutStartSec=900
