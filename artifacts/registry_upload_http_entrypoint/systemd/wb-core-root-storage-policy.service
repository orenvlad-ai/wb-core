[Unit]
Description=WB Core Root Storage Policy Status
After=local-fs.target
RequiresMountsFor=/opt/wb-core-runtime/state/backups /opt/wb-core-runtime/state/generations

[Service]
Type=oneshot
WorkingDirectory=/opt/wb-core-runtime/app
StateDirectory=wb-core-root-storage-policy
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=true
ExecStart=/usr/bin/python3 /opt/wb-core-runtime/app/apps/root_storage_policy.py status --output /var/lib/wb-core-root-storage-policy/status.json --fail-on-unregistered

[Install]
WantedBy=multi-user.target
