  },
  "instruction_discovery": {
    "common_source": "origin/main:AGENTS.md",
    "current_role_source": "origin/main:workspaces/WB Core · Кураторы/AGENTS.override.md",
    "role_delta": "workspaces/WB Core · Кураторы/AGENTS.override.md",
    "project_config": "workspaces/WB Core · Кураторы/.codex/config.toml",
