{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orenvlad-ai/wb-core/packages/contracts/codex_task_passport_v1.schema.json",
  "title": "wb-core Task Passport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "objective",
    "expected_result",
    "scope",
    "constraints",
    "acceptance",
    "closure",
    "autonomy",
    "initial_resources",
    "source"
  ],
  "properties": {
    "schema": {"const": "wb-core-task-passport/v1"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "expected_result": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_contour", "included", "excluded"],
      "properties": {
        "execution_contour": {
          "enum": [
            "read-only",
            "user-artifact",
            "repo-only",
            "live-runtime",
            "production-mutation",
            "archived-gas-guard"
          ]
        },
        "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "closure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reversible_technical_actions", "production_data_mutation", "human_only_reasons"],
      "properties": {
        "reversible_technical_actions": {"const": "authorized"},
        "production_data_mutation": {"enum": ["forbidden", "human-gated"]},
        "human_only_reasons": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "interactive-auth",
              "irreversible-data-risk",
              "material-scope-or-risk-change",
              "missing-credential",
              "new-external-destination",
              "platform-hard-stop",
              "security-or-permission-change"
            ]
          }
        }
      }
    },
    "initial_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curator_thread_id", "executor_thread_id"],
      "properties": {
        "curator_thread_id": {"type": "string", "minLength": 1},
        "executor_thread_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
