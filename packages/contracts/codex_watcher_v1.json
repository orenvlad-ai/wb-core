{
  "schema": "wb-core-codex-watcher/v1",
  "repository": "orenvlad-ai/wb-core",
  "registry_home": "~/.wb-core/orchestrator/v1",
  "dashboard": "http://127.0.0.1:8766",
  "cadence_minutes": 10,
  "watcher": {
    "model": "gpt-5.6-luna",
    "reasoning_effort": "medium",
    "target_batch_limit": 8,
    "lease_seconds": 540,
    "rotate_after_runs": 720
  },
  "arbiter": {
    "model": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "one_active_case_per_task": true,
    "stale_decision_check": true
  },
  "retry_policy": {
    "first_empty_system_error": "retry-same-executor-once",
    "second_empty_system_error": "open-unclaimed-incident-and-replace-executor",
    "third_identical_fingerprint": "open-sol-arbiter",
    "unbounded_restart_loop": false
  },
  "fallback_discovery": {
    "enabled": true,
    "require_local_codex_thread": true,
    "require_pinned": true,
    "require_repository_remote": "orenvlad-ai/wb-core",
    "exclude_projectless_and_non_repository_threads": true
  },
  "role_pinning": {
    "assignment_time_only": true,
    "curator_and_current_executor_required_before_registration": true,
    "watcher_title_pin_and_automation_readback_required_before_smoke": true,
    "heartbeat_repin": false,
    "manual_owner_unpin_preserved": true,
    "final_acceptance_unpins_roles": false
  },
  "report": {
    "lines": ["Статус", "Задача", "Прогресс · Осталось", "С прошлого отчёта", "Сейчас", "Блокер"],
    "blocker_only_for_strict_human_reason": true,
    "renderer": "python3 apps/codex_task_orchestrator.py report",
    "unit": "acceptance-envelope",
    "localized_statuses_only": true,
    "forbid_raw_machine_state": true,
    "accepted_phrase": "Задача принята",
    "accepted_by": "exact-curator-thread"
  },
  "attention_delivery": {
    "schema": "wb-core-attention-event/v1",
    "transport_semantics": "at-least-once-with-stable-event-id",
    "event_kinds": [
      "TECHNICAL_COMPLETION",
      "TERMINAL_FAILURE",
      "STRICT_HUMAN_GATE",
      "SERIOUS_STALL"
    ],
    "states": ["PENDING", "LEASED", "SENT", "RETRY", "ACKED", "STALE"],
    "curator_ack_required_before_terminal_acceptance_state": true,
    "reserve_batch_limit": 8,
    "stable_event_id_across_rotation": true
  },
  "acceptance": {
    "schema": "wb-core-acceptance-envelope/v1",
    "unit": "user-level-envelope",
    "states": ["OPEN", "DONE_PENDING_HANDOFF", "AWAITING_ACCEPTANCE", "ACCEPTED"],
    "single_phrase_without_task_name": true,
    "fail_closed_when_curator_has_multiple_waiting_envelopes": true,
    "required_members_must_all_be_terminal_and_acked": true,
    "required_member_addition_reopens_envelope": true,
    "owner_notification_is_revision_bound": true,
    "accepted_envelopes_excluded_from_report": true,
    "owner_handoff": {
      "schema": "wb-core-owner-handoff/v1",
      "commentary_delivery_before_confirmation": true,
      "repeat_same_digest_on_final_surface": true,
      "duplicate_final_surface_is_not_second_logical_notification": true,
      "required_lines": [
        "Статус: Завершена — требуется приёмка",
        "Сделано",
        "Проверено",
        "Ответьте ровно: «Задача принята»"
      ],
      "limitations_only_when_real": true
    }
  },
  "executor_succession": {
    "schema": "wb-core-executor-succession/v1",
    "archive_only_after_successor_readback": true,
    "archive_is_searchable_and_audited": true,
    "never_auto_unpin": ["curator", "current-executor"],
    "terminal_executor_without_successor_stays_current": true
  },
  "rotation": {
    "activate_only_after_smoke": true,
    "atomic_generation_switch": true,
    "old_generation_must_be_stale_noop": true,
    "pause_old_heartbeat_after_activation": true,
    "archive_old_watcher_after_readback": true,
    "old_watcher_retirement_evidence_required": true,
    "smoke_visible_report": {
      "renderer": "python3 apps/codex_task_orchestrator.py report",
      "unit": "acceptance-envelope",
      "localized_russian": true,
      "forbid_raw_machine_state": true,
      "require_meaningful_progress": true
    }
  },
  "feature_flag": {
    "name": "WB_CORE_ORCHESTRATION_REQUIRED",
    "default": false,
    "enable_only_after_pilot": true
  },
  "optional_layers": {
    "entire_observability": false,
    "telegram": false,
    "native_app_notifications": true
  }
}
