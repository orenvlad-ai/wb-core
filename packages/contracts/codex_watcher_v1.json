{
  "schema": "wb-core-codex-watcher/v1",
  "repository": "orenvlad-ai/wb-core",
  "registry_home": "~/.wb-core/orchestrator/v1",
  "dashboard": "http://127.0.0.1:8766",
  "cadence_minutes": 10,
  "watcher": {
    "model": "gpt-5.6-luna",
    "reasoning_effort": "medium",
    "target_batch_limit": 8,
    "lease_seconds": 540,
    "rotate_after_runs": 48,
    "planned_rotation_hours": 8,
    "context_compaction_signal": "read_thread.items[type=contextCompaction]",
    "automation_prompt_mode": "bounded-trusted-repo-entrypoint",
    "run_plan_command": "heartbeat-plan",
    "target_observation_command": "heartbeat-record-target",
    "actuation_command": "heartbeat-actuate",
    "finish_command": "heartbeat-finish"
  },
  "heartbeat_driver": {
    "schema": "wb-core-watcher-run-plan/v1",
    "observation_schema": "wb-core-watcher-target-observation/v1",
    "durable_run_receipts": true,
    "ordered_phases": [
      "snapshot-integrity-queue",
      "target-coverage",
      "progress-state",
      "objective-evidence",
      "apply-progress",
      "failure-incident",
      "terminal-evidence",
      "attention-delivery",
      "end-run",
      "heartbeat-response"
    ],
    "coverage_mode": "one-exact-target-per-immediate-readback",
    "early_batch_wake_cannot_complete_remaining_targets": true,
    "all_planned_targets_required_before_actuation": true,
    "active_target_followup": false,
    "idle_nonterminal_followup_limit_per_run": 1,
    "one_meaningful_transition_per_task_per_run": true,
    "terminal_evidence_binding": [
      "task-id",
      "task-revision",
      "executor-thread",
      "executor-generation",
      "turn-id",
      "final-item-id",
      "readback-digest",
      "completion-evidence-class",
      "completion-evidence-digest"
    ],
    "finish_requires_target_coverage": true,
    "finish_requires_attention_delivery": true,
    "finish_emits_only_canonical_wrapper": true
  },
  "arbiter": {
    "model": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "one_active_case_per_task": true,
    "stale_decision_check": true
  },
  "retry_policy": {
    "first_empty_system_error": "retry-same-executor-once",
    "second_empty_system_error": "open-unclaimed-incident-and-replace-executor",
    "third_identical_fingerprint": "open-sol-arbiter",
    "unbounded_restart_loop": false
  },
  "fallback_discovery": {
    "enabled": true,
    "require_local_codex_thread": true,
    "require_pinned": true,
    "require_repository_remote": "orenvlad-ai/wb-core",
    "exclude_projectless_and_non_repository_threads": true
  },
  "role_pinning": {
    "assignment_time_only": true,
    "curator_and_current_executor_required_before_registration": true,
    "watcher_title_pin_and_automation_readback_required_before_smoke": true,
    "heartbeat_repin": false,
    "manual_owner_unpin_preserved": true,
    "final_acceptance_unpins_roles": false
  },
  "progress": {
    "mapper": "apps/codex_task_orchestrator_spec.py:PROGRESS_PERCENT_BY_STAGE",
    "initial_registered_stage": "executor-started",
    "initial_registered_percent": 5,
    "pre_executor_percent": 0,
    "executor_checkpoint_command": "checkpoint-progress",
    "watcher_state_command": "progress-state",
    "watcher_apply_command": "apply-progress",
    "executor_assigns_percentage": false,
    "time_or_heartbeat_based_progress": false,
    "objective_github_release_evidence_precedes_self_report": true,
    "one_meaningful_transition_per_task_per_heartbeat": true,
    "fresh_same_stage_delta_allowed": true,
    "bounded_invalidation_levels": 1,
    "ordinary_test_finding_resets_progress": false,
    "terminal_percent": 100,
    "terminal_only": true,
    "terminal_evidence_by_contour": {
      "read-only": "diagnostic-complete",
      "user-artifact": "artifact-verified",
      "repo-only": "release:done",
      "live-runtime": "release:production",
      "production-mutation": "release:production",
      "archived-gas-guard": "release:done"
    }
  },
  "report": {
    "lines": ["Статус", "Задача", "Прогресс · Осталось", "С прошлого отчёта", "Сейчас", "Блокер"],
    "blocker_only_for_strict_human_reason": true,
    "renderer": "python3 apps/codex_task_orchestrator.py report",
    "unit": "acceptance-envelope-workstream",
    "parallel_root_and_required_child_blocks": true,
    "corrective_and_replacement_fold_into_workstream": true,
    "workstream_title_source": "anchor-task-title",
    "owner_acceptance_unit": "acceptance-envelope",
    "localized_statuses_only": true,
    "forbid_raw_machine_state": true,
    "accepted_phrase": "Задача принята",
    "accepted_by": "exact-curator-thread"
  },
  "heartbeat_response": {
    "command": "python3 apps/codex_task_orchestrator.py heartbeat-finish --generation <GENERATION> --owner <RUN_OWNER> --automation-id <AUTOMATION_ID>",
    "wrapper": "heartbeat",
    "active_envelopes_decision": "NOTIFY",
    "unchanged_active_envelopes_decision": "NOTIFY",
    "notify_message_source": "unmodified-canonical-report-stdout",
    "single_visible_output": true,
    "dont_notify_requires_no_active_report_blocks": true,
    "dont_notify_requires_no_owner_relevant_attention_or_incident": true,
    "quiet_message": "Нет активных задач.",
    "compaction_and_rotation_invariant": true,
    "changes_automation_state": false,
    "dont_notify_changes_automation_state": false
  },
  "attention_delivery": {
    "schema": "wb-core-attention-event/v1",
    "transport_semantics": "at-least-once-with-stable-event-id",
    "event_kinds": [
      "TECHNICAL_COMPLETION",
      "TERMINAL_FAILURE",
      "STRICT_HUMAN_GATE",
      "SERIOUS_STALL"
    ],
    "states": ["PENDING", "LEASED", "SENT", "RETRY", "ACKED", "STALE"],
    "curator_ack_required_before_terminal_acceptance_state": true,
    "reserve_batch_limit": 8,
    "stable_event_id_across_rotation": true
  },
  "acceptance": {
    "schema": "wb-core-acceptance-envelope/v1",
    "unit": "user-level-envelope",
    "states": ["OPEN", "DONE_PENDING_HANDOFF", "AWAITING_ACCEPTANCE", "ACCEPTED"],
    "single_phrase_without_task_name": true,
    "fail_closed_when_curator_has_multiple_waiting_envelopes": true,
    "required_members_must_all_be_terminal_and_acked": true,
    "required_member_addition_reopens_envelope": true,
    "owner_notification_is_revision_bound": true,
    "accepted_envelopes_excluded_from_report": true,
    "owner_handoff": {
      "schema": "wb-core-owner-handoff/v1",
      "commentary_delivery_before_confirmation": true,
      "repeat_same_digest_on_final_surface": true,
      "duplicate_final_surface_is_not_second_logical_notification": true,
      "required_lines": [
        "Статус: Завершена — требуется приёмка",
        "Сделано",
        "Проверено",
        "Ответьте ровно: «Задача принята»"
      ],
      "limitations_only_when_real": true
    }
  },
  "executor_succession": {
    "schema": "wb-core-executor-succession/v1",
    "archive_only_after_successor_readback": true,
    "archive_is_searchable_and_audited": true,
    "never_auto_unpin": ["curator", "current-executor"],
    "terminal_executor_without_successor_stays_current": true
  },
  "rotation": {
    "run_boundary": {
      "not_due_run_count": 47,
      "due_run_count": 48
    },
    "early_trigger": {
      "source": "supported Desktop read_thread exact typed item",
      "item_type": "contextCompaction",
      "record_command": "record-watcher-context-compaction",
      "heuristic_detection": false,
      "fallback_when_signal_unavailable": "hard-run-cap"
    },
    "active_tasks_may_rotate": true,
    "no_monitoring_gap": true,
    "automation_state_readback_command": "confirm-watcher-automation-enabled",
    "automation_enabled_evidence_sources": [
      "Desktop automation_update mode=view",
      "exact local automation.toml status=ACTIVE readback"
    ],
    "old_automation_pause_gate": "successor-first-post-cutover-heartbeat-liveness",
    "successor_liveness_command": "confirm-watcher-liveness",
    "successor_liveness_evidence": [
      "active-begin-run",
      "full-heartbeat-wrapper-readback",
      "successful-end-run",
      "enabled-successor-automation-readback"
    ],
    "first_run_failure_command": "record-watcher-liveness-failure",
    "first_run_failure_recovery": "retry-active-successor-same-automation",
    "old_automation_remains_enabled_during_recovery": true,
    "dual_scheduled_generations_may_overlap_temporarily": true,
    "dual_mutation_authority": false,
    "prepared_successor_canary_read_only": true,
    "prepared_successor_task_github_attention_mutations": false,
    "state_sources": ["registry", "events.jsonl", "current-github", "trusted-origin-main"],
    "chat_context_transfer": false,
    "activate_only_after_smoke": true,
    "preactivation_failure_keeps_current_active": true,
    "postactivation_old_authority_restorable": false,
    "postactivation_cleanup_resumable": true,
    "atomic_generation_switch": true,
    "old_generation_must_be_stale_noop": true,
    "pause_old_heartbeat_after_activation": true,
    "archive_old_watcher_after_readback": true,
    "old_watcher_retirement_evidence_required": true,
    "smoke_visible_report": {
      "renderer": "python3 apps/codex_task_orchestrator.py report",
      "unit": "acceptance-envelope-workstream",
      "localized_russian": true,
      "forbid_raw_machine_state": true,
      "require_meaningful_progress": true,
      "require_initial_five_percent": true,
      "require_two_independent_envelopes": true,
      "require_parallel_workstreams_in_one_envelope": true,
      "require_corrective_workstream_folding": true,
      "forbid_time_based_progress": true,
      "require_fresh_same_stage_delta": true,
      "require_objective_late_stage": true,
      "require_unchanged_active_notify": true,
      "require_quiet_dont_notify": true
    }
  },
  "feature_flag": {
    "name": "WB_CORE_ORCHESTRATION_REQUIRED",
    "default": false,
    "enable_only_after_pilot": true
  },
  "optional_layers": {
    "entire_observability": false,
    "telegram": false,
    "native_app_notifications": true
  }
}
