{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selleros.local/schemas/validator_request.schema.json",
  "type": "object",
  "properties": {
    "request_schema_version": {"type": "string", "const": "1.0.0"},
    "review_input": {"$ref": "https://selleros.local/schemas/review_input.schema.json"},
    "classification": {"$ref": "https://selleros.local/schemas/classification.schema.json"},
    "draft": {"$ref": "https://selleros.local/schemas/draft_reply.schema.json"},
    "final_route": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/route"},
    "case_code": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/case_code"},
    "product_facts": {"type": "array", "items": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/product_fact"}, "maxItems": 30},
    "playbook_fragments": {"type": "array", "items": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/playbook_fragment"}, "maxItems": 20},
    "positive_guidance": {"type": "array", "items": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/positive_guidance"}, "maxItems": 10},
    "approved_examples": {"type": "array", "items": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/approved_example"}, "maxItems": 5},
    "draft_constraints": {"$ref": "https://selleros.local/schemas/common_prompt_context.schema.json#/$defs/draft_constraints"},
    "attempt_number": {"type": "integer", "minimum": 0, "maximum": 2},
    "max_rewrites": {"type": "integer", "const": 2}
  },
  "required": ["request_schema_version", "review_input", "classification", "draft", "final_route", "case_code", "product_facts", "playbook_fragments", "positive_guidance", "approved_examples", "draft_constraints", "attempt_number", "max_rewrites"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"final_route": {"const": "seller_chat"}}, "required": ["final_route"]},
      "then": {"properties": {"case_code": {"type": "string", "pattern": "^[А-ЯЁ][0-9]{4}$"}}},
      "else": {"properties": {"case_code": {"type": "null"}}}
    }
  ]
}
