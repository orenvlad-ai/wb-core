{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selleros.local/schemas/common_prompt_context.schema.json",
  "type": "object",
  "properties": {},
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "route": {
      "type": "string",
      "enum": ["public_only", "seller_chat", "wb_return", "wb_support"]
    },
    "case_code": {
      "type": ["string", "null"],
      "pattern": "^[А-ЯЁ][0-9]{4}$"
    },
    "versioned_context": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "string"},
        "doctrine_version": {"type": "string", "const": "1.0"}
      },
      "required": ["schema_version", "doctrine_version"],
      "additionalProperties": true
    },
    "product_fact": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fact": {"type": "string", "minLength": 1},
        "source": {
          "type": "string",
          "enum": ["universal", "product_line", "sku", "review", "media"]
        }
      },
      "required": ["id", "fact", "source"],
      "additionalProperties": false
    },
    "playbook_fragment": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "allowed_routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route"},
          "minItems": 1,
          "uniqueItems": true
        },
        "decision_rule": {"type": "string"},
        "potential_evidence": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "prohibited_claims": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["code", "label", "allowed_routes", "decision_rule", "potential_evidence", "prohibited_claims"],
      "additionalProperties": false
    },
    "positive_guidance": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "response_rule": {"type": "string"}
      },
      "required": ["code", "label", "response_rule"],
      "additionalProperties": false
    },
    "approved_example": {
      "type": "object",
      "properties": {
        "case_id": {"type": "string"},
        "issue_codes": {"type": "array", "items": {"type": "string"}},
        "issue_subtype": {"type": ["string", "null"]},
        "route": {"$ref": "#/$defs/route"},
        "review_pattern": {"type": "string"},
        "approved_reply": {"type": "string", "minLength": 2}
      },
      "required": ["case_id", "issue_codes", "issue_subtype", "route", "review_pattern", "approved_reply"],
      "additionalProperties": false
    },
    "draft_constraints": {
      "type": "object",
      "properties": {
        "must_start_with": {"type": "string", "const": "Здравствуйте."},
        "must_include": {"type": "array", "items": {"type": "string"}},
        "must_not_include": {"type": "array", "items": {"type": "string"}},
        "cta": {"$ref": "#/$defs/route"},
        "target_sentences": {"type": "string"},
        "target_chars": {"type": "string"},
        "soft_max_chars": {"type": "integer", "const": 700},
        "hard_max_chars": {"type": "integer", "const": 900},
        "positive_signals_to_reflect": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["must_start_with", "must_include", "must_not_include", "cta", "target_sentences", "target_chars", "soft_max_chars", "hard_max_chars", "positive_signals_to_reflect"],
      "additionalProperties": false
    }
  }
}
