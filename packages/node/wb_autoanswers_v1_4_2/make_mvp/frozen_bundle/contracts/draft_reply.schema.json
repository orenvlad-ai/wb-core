{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selleros.local/schemas/draft_reply.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "review_id": {
      "type": "string"
    },
    "review_version": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "public_only",
        "seller_chat",
        "wb_return",
        "wb_support"
      ]
    },
    "case_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "draft_reply": {
      "type": "string",
      "minLength": 2,
      "maxLength": 900
    },
    "covered_issue_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "DELIVERY_DAMAGE",
          "DEFECT_OUT_OF_BOX",
          "MISSING_PARTS",
          "KIT_QUALITY",
          "WRONG_ITEM",
          "OPENED_USED",
          "INSTALL_MECHANISM",
          "INSTALL_BREAKAGE",
          "INSTALL_GENERAL",
          "BUBBLES_DUST",
          "ADHESION",
          "ALIGNMENT",
          "INSTRUCTIONS",
          "SIZE_FIT",
          "FRAME_OVERLAP",
          "CASE_CONFLICT",
          "FRAMELESS",
          "SPONTANEOUS_BREAKAGE",
          "IMPACT_BREAKAGE",
          "SCRATCH_WEAR",
          "DEVICE_DAMAGE_CLAIM",
          "INJURY_CLAIM",
          "PRIVACY",
          "MATTE",
          "DISPLAY_QUALITY",
          "TOUCH_SENSITIVITY",
          "FACE_ID",
          "FRONT_CAMERA",
          "EARPIECE",
          "OLEOPHOBIC",
          "TACTILE_EDGE",
          "DESCRIPTION_MISMATCH",
          "SERVICE_GUARANTEE",
          "WB_REFUND_STATUS",
          "PRICE_VALUE",
          "VAGUE_QUALITY",
          "POSITIVE_NO_PROBLEM",
          "MEDIA_ONLY_UNCLEAR",
          "LEGAL_OR_FRAUD_CLAIM",
          "OTHER_SPECIFIC"
        ]
      },
      "minItems": 0,
      "maxItems": 20
    },
    "covered_positive_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "POS_INSTALLATION",
          "POS_QUALITY",
          "POS_PROTECTION",
          "POS_REPEAT_PURCHASE",
          "POS_PRODUCT_FEATURE",
          "POS_GENERAL"
        ]
      },
      "minItems": 0,
      "maxItems": 10
    },
    "used_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 30
    },
    "applied_cta": {
      "type": "string",
      "enum": [
        "none",
        "seller_chat",
        "wb_return",
        "wb_support"
      ]
    },
    "requested_materials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "review_version",
    "route",
    "case_code",
    "draft_reply",
    "covered_issue_codes",
    "covered_positive_codes",
    "used_fact_ids",
    "applied_cta",
    "requested_materials"
  ],
  "additionalProperties": false,
  "title": "Writer output"
}
