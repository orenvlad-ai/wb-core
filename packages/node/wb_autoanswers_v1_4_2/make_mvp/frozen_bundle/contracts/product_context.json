{
  "schema_version": "1.0.0",
  "doctrine_version": "1.0",
  "source_note": "Индекс отражает товары, встреченные в двух корпусах, но не подтверждает текущий статус продаж.",
  "universal_facts": [
    {
      "id": "INSTALL_KIT",
      "fact": "Комплект включает влажную и сухую очистку, микрофибру, установочный бокс с интегрированным стеклом и подложку для телефона."
    },
    {
      "id": "INSTALL_CLEANING",
      "fact": "Экран очищается сначала влажным, затем сухим способом; установку выполняют при минимальном количестве пыли."
    },
    {
      "id": "INSTALL_BOX",
      "fact": "Бокс ставится язычком со стрелкой вниз и плотно удерживается на телефоне."
    },
    {
      "id": "INSTALL_PULL",
      "fact": "Язычок вытягивается полностью, медленно и плавно."
    },
    {
      "id": "INSTALL_FINISH",
      "fact": "После выхода плёнки выполняются предусмотренные нажатия и движение по центральной линии для выхода воздуха."
    },
    {
      "id": "BUBBLES",
      "fact": "Крупный пузырь обрабатывают сразу локальным приподниманием ближайшего участка; микропузыри без пыли могут уменьшиться в течение суток."
    },
    {
      "id": "PROTECTION_LIMIT",
      "fact": "Стекло снижает риск повреждения экрана, но не гарантирует защиту при любом ударе; результат зависит от силы, угла и точки контакта."
    }
  ],
  "line_contexts": {
    "transparent": {
      "confirmed_facts": [
        "При правильной установке не должно заметно искажать изображение, фронтальную камеру, Face ID, сенсор или разговорный динамик."
      ],
      "forbidden_cross_line_facts": [
        "матовая зернистость",
