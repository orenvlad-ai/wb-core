{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selleros.local/schemas/pipeline_result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "review_id": {
      "type": "string"
    },
    "review_version": {
      "type": "string"
    },
    "publication_action": {
      "type": "string",
      "enum": [
        "reply",
        "skip"
      ]
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "empty_five_star",
        null
      ]
    },
    "review_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "positive",
        "mixed",
        "negative",
        null
      ]
    },
    "primary_issue": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELIVERY_DAMAGE",
        "DEFECT_OUT_OF_BOX",
        "MISSING_PARTS",
        "KIT_QUALITY",
        "WRONG_ITEM",
        "OPENED_USED",
        "INSTALL_MECHANISM",
        "INSTALL_BREAKAGE",
        "INSTALL_GENERAL",
        "BUBBLES_DUST",
        "ADHESION",
        "ALIGNMENT",
        "INSTRUCTIONS",
        "SIZE_FIT",
        "FRAME_OVERLAP",
        "CASE_CONFLICT",
        "FRAMELESS",
        "SPONTANEOUS_BREAKAGE",
        "IMPACT_BREAKAGE",
        "SCRATCH_WEAR",
        "DEVICE_DAMAGE_CLAIM",
        "INJURY_CLAIM",
        "PRIVACY",
        "MATTE",
        "DISPLAY_QUALITY",
        "TOUCH_SENSITIVITY",
        "FACE_ID",
        "FRONT_CAMERA",
        "EARPIECE",
        "OLEOPHOBIC",
        "TACTILE_EDGE",
        "DESCRIPTION_MISMATCH",
        "SERVICE_GUARANTEE",
        "WB_REFUND_STATUS",
        "PRICE_VALUE",
        "VAGUE_QUALITY",
        "POSITIVE_NO_PROBLEM",
        "MEDIA_ONLY_UNCLEAR",
        "LEGAL_OR_FRAUD_CLAIM",
        "OTHER_SPECIFIC",
        null
      ]
    },
    "primary_issue_subtype": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "delivery_delay",
        "seller_support_no_response",
        "promo_access_blocked",
        null
      ]
    },
    "positive_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "POS_INSTALLATION",
          "POS_QUALITY",
          "POS_PROTECTION",
          "POS_REPEAT_PURCHASE",
          "POS_PRODUCT_FEATURE",
          "POS_GENERAL"
        ]
      },
      "minItems": 0,
      "maxItems": 10
    },
    "route": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "public_only",
        "seller_chat",
        "wb_return",
        "wb_support",
        null
      ]
    },
    "route_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_materials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "draft_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 3
    },
    "validation_status_history": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pass",
          "rewrite",
          "fallback"
        ]
      },
      "minItems": 0,
      "maxItems": 3
    },
    "final_reply": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 900
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ready",
        "skipped",
        "fallback",
        "retryable_error",
        "terminal_error"
      ]
    },
    "model_call_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "versions": {
      "type": "object",
      "properties": {
        "doctrine": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "product_context": {
          "type": "string"
        },
        "classifier_prompt": {
          "type": "string"
        },
        "writer_prompt": {
          "type": "string"
        },
        "validator_prompt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "doctrine",
        "product_context",
        "classifier_prompt",
        "writer_prompt",
        "validator_prompt",
        "model"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "review_version",
    "publication_action",
    "skip_reason",
    "review_mode",
    "primary_issue",
    "primary_issue_subtype",
    "positive_signals",
    "route",
    "route_reason",
    "case_code",
    "requested_materials",
    "draft_history",
    "validation_status_history",
    "final_reply",
    "outcome",
    "model_call_count",
    "versions"
  ],
  "additionalProperties": false,
  "title": "Pipeline result"
}
