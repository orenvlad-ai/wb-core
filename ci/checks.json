{
  "schema": "wb-core.check-map/v1",
  "groups": {
    "process": {
      "patterns": [
        ".github/workflows/**",
        "ci/**",
        "apps/github_release_runner.py",
        "apps/github_release_runner_smoke.py",
        "apps/production_apply_launcher.py",
        "apps/production_apply_launcher_smoke.py"
      ],
      "commands": [
        ["python3", "ci/select_checks_smoke.py"],
        ["python3", "apps/github_release_runner_smoke.py"],
        ["python3", "apps/production_apply_launcher_smoke.py"]
      ],
      "pip": []
    },
    "autoanswers": {
      "patterns": [
        "apps/*autoanswers*.py",
        "packages/**/*autoanswers*.py",
        "packages/node/wb_autoanswers_v1_4_2/**"
      ],
      "commands": [
        ["python3", "apps/wb_autoanswers_store_rollback_smoke.py"]
      ],
      "pip": []
    },
    "finance": {
      "patterns": [
        "apps/*finance*.py",
        "packages/**/*finance*.py",
        "packages/**/*cost*.py"
      ],
      "commands": [
        ["python3", "apps/wb_finance_weekly_smoke.py"]
      ],
      "pip": ["openpyxl==3.1.5", "xlrd==2.0.1"]
    },
    "warehouse": {
      "patterns": [
        "apps/*warehouse*.py",
        "apps/ff_stock*.py",
        "packages/**/*warehouse*.py",
        "packages/**/*ff_stock*.py"
      ],
      "commands": [
        ["python3", "apps/warehouse_stocks_smoke.py"],
        ["python3", "apps/ff_stock_ledger_smoke.py"]
      ],
      "pip": ["openpyxl==3.1.5"]
    },
    "web_vitrina": {
      "patterns": [
        "apps/*web_vitrina*.py",
        "packages/**/*web_vitrina*.py",
        "packages/adapters/templates/sheet_vitrina_v1_operator.html"
      ],
      "commands": [
        ["python3", "apps/sheet_vitrina_v1_web_vitrina_contract_smoke.py"]
      ],
      "pip": ["openpyxl==3.1.5"]
    },
    "supply": {
      "patterns": [
        "apps/*supply*.py",
        "packages/**/*supply*.py",
        "packages/**/*shipment*.py"
      ],
      "commands": [
        ["python3", "apps/wb_regional_supply_smoke.py"]
      ],
      "pip": ["openpyxl==3.1.5"]
    },
    "inventory_balance": {
      "patterns": [
        "apps/sku_inventory_balance*.py",
        "packages/application/sku_inventory_balance.py",
        "packages/application/sku_management.py",
        "packages/application/official_fbs_stock_read.py"
      ],
      "commands": [
        [
          "python3",
          "apps/sku_inventory_balance_smoke.py"
        ],
        [
          "python3",
          "apps/sku_inventory_balance_live_apply_smoke.py"
        ],
        [
          "python3",
          "apps/sku_management_smoke.py"
        ]
      ],
      "pip": [
        "openpyxl==3.1.5"
      ]
    },
    "inventory_balance_browser": {
      "patterns": [
        "apps/sku_inventory_balance_browser_smoke.py",
        "packages/adapters/templates/sheet_vitrina_v1_web_vitrina.html"
      ],
      "commands": [
        [
          "python3",
          "-m",
          "playwright",
          "install",
          "--with-deps",
          "chromium"
        ],
        [
          "python3",
          "apps/sku_inventory_balance_browser_smoke.py"
        ]
      ],
      "pip": [
        "openpyxl==3.1.5",
        "playwright==1.58.0"
      ]
    },
    "change_registry_writer": {
      "patterns": [
        "packages/application/change_registry_writer.py",
        "apps/change_registry_internal_writers_smoke.py"
      ],
      "commands": [
        [
          "python3",
          "apps/change_registry_internal_writers_smoke.py"
        ]
      ],
      "pip": [
        "openpyxl==3.1.5"
      ]
    }
  }
}
